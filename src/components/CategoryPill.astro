---
export interface Props {
  label: string;
  active?: boolean;
  asButton?: boolean;
}
const { label, active = false, asButton = false } = Astro.props;
const Tag = asButton ? 'button' : 'span';
---

<Tag
  type={asButton ? 'button' : undefined}
  class={`pill ${active ? '!border-accent-500 !text-accent-600 !bg-accent-500/10' : ''}`}
  aria-pressed={asButton ? active : undefined}
  data-filter={asButton ? label : undefined}
>
  {label}
</Tag>
