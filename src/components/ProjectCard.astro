---
import CategoryPill from './CategoryPill.astro';

export interface Project {
  title: string;
  slug: string;
  year: number;
  category: string;
  summary: string;
  stack: string[];
  tech: string[];
  githubUrl: string | null;
  demoUrl?: string;
  thumbnail: string;
  images?: string[];
  status: 'Public' | 'Private' | 'Coming Soon';
  featured: boolean;
  caseStudy?: boolean;
  metrics?: Array<{ label: string; value: string }>;
}

export interface Props {
  index: number;
  project: Project;
}

const { index, project } = Astro.props;
const idx = String(index).padStart(2, '0');
const gallery = project.images && project.images.length > 0 ? project.images : [project.thumbnail];
const hasMultiple = gallery.length > 1;

// Image-slug → alt map. Each value describes what's in the screenshot,
// not just the project name. Falls back to a generic alt when unmapped.
const alts: Record<string, string> = {
  // ADV — DWG clash detection
  'adv-cad-validation/0': 'CAD drawing of test1 (Sheet 0001) with multiple hard-clash markers highlighted across structural members',
  'adv-cad-validation/1': 'Hard-clash detail popover showing two polygon intersections and traceability IDs',
  'adv-cad-validation/2': 'Overlay mode blending the mechanical layer over structural members with annotation tools',
  'adv-cad-validation/3': 'Zoomed-in structural view with hard-clash markers concentrated at a central node',
  'adv-cad-validation/4': 'Annotation mode marking a hard-clash region with a callout dimension',

  // IntelliCredit — credit appraisal
  'intellicredit/0': 'Credit appraisal memo for Tata Steel: score 743, BBB+ risk, 7-agent LangGraph workflow',
  'intellicredit/1': 'Decline decision card explaining a phantom-ITC mismatch with a 3-step counterfactual path-to-approve',
  'intellicredit/2': 'GSTR-2A vs GSTR-3B reconciliation matrix for seven suppliers with colored heatmap',

  // OS-Devin — eval harness
  'os-devin-eval-harness/0': '18×3 evaluation matrix showing pass-rate per task across gpt-4o, Claude Opus, and Gemini 1.5',
  'os-devin-eval-harness/1': 'Component ablation matrix showing self-heal adds +18 points, AST guard +12, sandbox −9',
  'os-devin-eval-harness/2': 'Agent trace timeline: planner, code, reviewer, debugger iterations over a 42-second run',

  // Foretell Vista — federated forecasting
  'foretell-vista/0': '7-day demand forecast chart for SKU-5821 with a promo flag mid-week and confidence band',
  'foretell-vista/1': 'Federated training console: per-silo loss curves converging at round 42 of 60',
  'foretell-vista/2': 'Ray RLlib replenishment training curve and top-10 SKU reorder queue with confidence scores',

  // Rail Yard — yard scheduling
  'rail-yard-slot-and-conflict-manager/0': '6-track yard schedule for Pune Junction showing 12 active trains and zero conflicts',
  'rail-yard-slot-and-conflict-manager/1': 'DB-rejected reservation: timeline showing the overlap window on track PL-02 with fix suggestions',
  'rail-yard-slot-and-conflict-manager/2': 'Reservation drawer for T-22841 with all GiST exclusion pre-checks passing',

  // AfterMath — SRE agent
  'aftermath-sre-agent/0': 'Live triage of INC-2026-1142 across the four Diagnose-Act-Record-Consolidate stages with the agent chat log',
  'aftermath-sre-agent/1': 'Memory bank browser listing 487 episodes with one high-confidence fix selected',
  'aftermath-sre-agent/2': 'GRR forensic analyst view of file collection and process list from the referenced tool',

  // SAR-AI — AML compliance
  'sar-ai-compliance/0': 'Transaction graph showing EU counterparties (some OFAC-flagged) flowing through a customer to a Chinese exchange',
  'sar-ai-compliance/1': 'SAR narrative with clickable sentence-level provenance and the 5-agent execution trace',
  'sar-ai-compliance/2': 'Case analytics dashboard with 30 days of filings and a constitutional-AI refusal log',

  // SignHear — voice-to-sign
  'signhear/0': 'Live translation window: audio waveform, running transcript, and a Sutton SignWriting stick figure',
  'signhear/1': '5-stage offline pipeline diagram with a 1.29-second sync latency budget per stage',
  'signhear/2': 'Settings panel showing three active ASR languages and dictionary coverage',

  // NHAI Netra — mobile field verification
  'nhai-netra/0': 'NHAI field operations check-in screen with biometric pipeline, 94% average trust, 28 successes',
  'nhai-netra/1': 'Tamper-evident SHA-256 ledger history showing four check-ins with trust scores 91–95',
  'nhai-netra/2': 'Cloud synchronization screen confirming 4 records synced successfully',
  'nhai-netra/3': 'Alternate check-in screen with status bar and same biometric pipeline',
};

const altFor = (i: number) =>
  alts[`${project.slug}/${i}`] ??
  `${project.title} screenshot ${i + 1}`;
---

<article
  class="card p-5 sm:p-6 flex flex-col"
  data-project-card
  data-category={project.category}
  data-status={project.status}
>
  <header class="flex items-start justify-between gap-3 mb-4">
    <span class="num text-sm text-teal-400">{idx}</span>
    <div class="flex items-center gap-2">
      {project.status === 'Private' && (
        <span class="pill !border-slate-700 !text-slate-500">Private</span>
      )}
      {project.status === 'Coming Soon' && (
        <span class="pill !border-slate-700 !text-slate-500">Soon</span>
      )}
      <CategoryPill label={project.category} />
    </div>
  </header>

  <div
    class="aspect-[16/9] mb-4 bg-navy-900 rounded-sm overflow-hidden border border-line relative group"
    data-carousel
  >
    <img
      src={gallery[0]}
      alt={altFor(0)}
      class="w-full h-full object-cover transition-opacity duration-200"
      data-carousel-img
      data-sources={JSON.stringify(gallery)}
      data-alts={JSON.stringify(gallery.map((_, i) => altFor(i)))}
      loading="lazy"
    />
    {hasMultiple && (
      <>
        <button
          type="button"
          aria-label="Previous image"
          data-carousel-prev
          class="absolute top-1/2 left-2 -translate-y-1/2 w-10 h-10 bg-black/85 hover:bg-black border border-white/20 hover:border-white/40 rounded-full flex items-center justify-center text-white shadow-lg shadow-black/60 transition-all hover:scale-110"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M15 18l-6-6 6-6"/>
          </svg>
        </button>
        <button
          type="button"
          aria-label="Next image"
          data-carousel-next
          class="absolute top-1/2 right-2 -translate-y-1/2 w-10 h-10 bg-black/85 hover:bg-black border border-white/20 hover:border-white/40 rounded-full flex items-center justify-center text-white shadow-lg shadow-black/60 transition-all hover:scale-110"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M9 18l6-6-6-6"/>
          </svg>
        </button>
        <div class="absolute bottom-2 left-1/2 -translate-x-1/2 flex gap-1.5 px-2 py-1 bg-navy-950/80 rounded-full" data-carousel-dots>
          {gallery.map((_, i) => (
            <span
              class={`w-2 h-2 rounded-full transition-all cursor-pointer ${i === 0 ? 'bg-teal-400 w-5' : 'bg-slate-400/60 hover:bg-slate-300'}`}
              data-carousel-dot={i}
              aria-hidden="true"
            ></span>
          ))}
        </div>
        <div class="absolute top-2 right-2 px-2 py-1 bg-navy-950/90 border border-teal-400/40 rounded text-[11px] text-teal-400 num font-mono font-semibold">
          <span data-carousel-current>1</span>/{gallery.length}
        </div>
      </>
    )}
  </div>

  <h3 class="text-lg sm:text-xl font-semibold text-ink text-balance mb-2">
    {project.title}
  </h3>
  <p class="text-slate-300 text-sm text-pretty mb-4 flex-1">{project.summary}</p>

  {project.metrics && project.metrics.length > 0 && (
    <dl class="grid grid-cols-2 sm:grid-cols-4 gap-2 mb-4 text-center">
      {project.metrics.map((m) => (
        <div class="border border-line rounded-sm py-2 px-1">
          <dt class="meta !text-[0.6rem] mb-1">{m.label}</dt>
          <dd class="num text-sm text-ink">{m.value}</dd>
        </div>
      ))}
    </dl>
  )}

  <div class="flex flex-wrap gap-1.5 mb-4">
    {project.tech.slice(0, 5).map((t) => <span class="pill !text-[0.65rem]">{t}</span>)}
  </div>

  <footer class="flex flex-wrap items-center gap-3 text-sm">
    {project.caseStudy && (
      <a
        href={`/projects/${project.slug}/`}
        class="text-teal-400 hover:text-teal-DEFAULT transition-colors inline-flex items-center gap-1.5"
      >
        <span class="num">case study →</span>
      </a>
    )}
    {project.githubUrl ? (
      <a
        href={project.githubUrl}
        target="_blank"
        rel="noreferrer noopener"
        class="text-slate-300 hover:text-teal-400 transition-colors inline-flex items-center gap-1.5"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.13-3.2.69-3.87-1.36-3.87-1.36-.52-1.32-1.28-1.67-1.28-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.95 10.95 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.25 5.69.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.13 0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
        </svg>
        <span class="num">source</span>
      </a>
    ) : (
      <span class="text-slate-500 inline-flex items-center gap-1.5">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/>
        </svg>
        <span class="num">private</span>
      </span>
    )}
    {project.demoUrl && (
      <>
        <span class="text-slate-700">·</span>
        <a
          href={project.demoUrl}
          target="_blank"
          rel="noreferrer noopener"
          class="text-teal-400 hover:text-teal-DEFAULT transition-colors inline-flex items-center gap-1.5"
        >
          <span class="num">live ↗</span>
        </a>
      </>
    )}
    <span class="ml-auto meta">{project.year}</span>
  </footer>
</article>

<script>
  // Manual-only carousel: click arrows or dots to navigate. No auto-rotation.
  const initCarousel = (root: HTMLElement) => {
    if (root.dataset.bound === '1') return;
    root.dataset.bound = '1';

    const img = root.querySelector<HTMLImageElement>('[data-carousel-img]');
    const prev = root.querySelector<HTMLButtonElement>('[data-carousel-prev]');
    const next = root.querySelector<HTMLButtonElement>('[data-carousel-next]');
    const dots = Array.from(root.querySelectorAll<HTMLSpanElement>('[data-carousel-dot]'));
    const counter = root.querySelector<HTMLSpanElement>('[data-carousel-current]');
    if (!img) return;

    const total = dots.length || 1;
    let idx = 0;

    const gallery: string[] = (() => {
      const raw = img.getAttribute('data-sources');
      if (raw) {
        try { return JSON.parse(raw); } catch { return []; }
      }
      return [img.src];
    })();

    const alts: string[] = (() => {
      const raw = img.getAttribute('data-alts');
      if (raw) {
        try { return JSON.parse(raw); } catch { return []; }
      }
      return [img.alt];
    })();

    const render = () => {
      img.src = gallery[idx];
      const altText = alts[idx];
      if (altText) img.alt = altText;
      if (counter) counter.textContent = String(idx + 1);
      dots.forEach((d, i) => {
        d.classList.toggle('bg-teal-400', i === idx);
        d.classList.toggle('bg-slate-500/60', i !== idx);
      });
    };

    const go = (delta: number) => {
      if (total < 2) return;
      idx = (idx + delta + total) % total;
      render();
    };

    prev?.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); go(-1); });
    next?.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); go(+1); });
    dots.forEach((d, i) => {
      d.addEventListener('click', (e) => {
        e.preventDefault(); e.stopPropagation();
        idx = i;
        render();
      });
    });

    // Keyboard navigation when carousel is focused
    root.tabIndex = 0;
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') { e.preventDefault(); go(-1); }
      else if (e.key === 'ArrowRight') { e.preventDefault(); go(+1); }
    });
  };

  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach(initCarousel);
</script>
