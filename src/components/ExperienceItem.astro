---
export interface Props {
  index: number;
  company: string;
  website?: string;
  role: string;
  period: string;
  location?: string;
  summary: string;
  bullets: string[];
  technologies: string[];
}

const { index, company, website, role, period, location, summary, bullets, technologies } = Astro.props;
const idx = String(index).padStart(2, '0');
---

<article class="grid grid-cols-[auto_1fr] gap-x-6 sm:gap-x-8 group">
  <div class="flex flex-col items-center">
    <span class="num text-sm text-teal-400">{idx}</span>
    <span class="block w-px flex-1 bg-line mt-3 group-last:hidden"></span>
  </div>

  <div class="pb-12">
    <header class="mb-3">
      <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
        <h3 class="text-lg sm:text-xl font-semibold text-ink">{role}</h3>
        <span class="num text-sm text-slate-500">·</span>
        {website ? (
          <a
            href={website}
            target="_blank"
            rel="noopener noreferrer"
            class="text-teal-400 hover:underline inline-flex items-baseline gap-1"
          >
            <span>{company}</span>
            <span aria-hidden="true" class="text-xs">↗</span>
          </a>
        ) : (
          <span class="text-teal-400">{company}</span>
        )}
      </div>
      <div class="meta text-slate-500 mt-1">
        {period}{location && <span> · {location}</span>}
      </div>
    </header>

    <p class="text-slate-300 text-pretty mb-4 max-w-prose-thin">{summary}</p>

    <ul class="space-y-2 text-slate-300 text-pretty">
      {bullets.map((b) => (
        <li class="flex gap-3">
          <span class="text-teal-400 mt-1.5" aria-hidden="true">▸</span>
          <span>{b}</span>
        </li>
      ))}
    </ul>

    <div class="mt-5 flex flex-wrap gap-2">
      {technologies.map((t) => <span class="pill">{t}</span>)}
    </div>
  </div>
</article>
