---
export interface Props {
  degree: string;
  major: string;
  college: string;
  period: string;
  cgpa: string;
  cgpaScale?: string;
  scholarship?: string;
  title?: string;
}

const {
  degree,
  major,
  college,
  period,
  cgpa,
  cgpaScale = '/ 10',
  scholarship,
  title = '// education',
} = Astro.props;
---

<section class="space-y-5" aria-labelledby="education-heading">
  <header class="flex items-center gap-3">
    <span aria-hidden="true" class="marker"></span>
    <h2 id="education-heading" class="meta">{title}</h2>
  </header>

  <article class="card p-5 sm:p-6">
    <header class="mb-4">
      <p class="meta text-ink-500 mb-1">{period}</p>
      <h3 class="font-display font-extrabold text-lg sm:text-xl text-ink-900 leading-tight text-balance mb-1">
        {degree}
      </h3>
      <p class="text-sm text-ink-700 text-pretty leading-snug">
        {major}
      </p>
    </header>

    <p class="meta text-ink-500 mb-5">
      <span class="font-display text-base text-ink-900 not-italic">{college}</span>
      <span class="mx-1.5 text-ink-300">·</span>
      <span>B.Tech · IoT &amp; Cybersecurity track</span>
    </p>

    <div class="flex items-end justify-between gap-4 border-t border-line pt-4">
      <div class="min-w-0">
        <p class="meta text-ink-500 mb-1">CGPA</p>
        <p class="num text-3xl sm:text-4xl text-ink-900 leading-none">
          <span>{cgpa}</span>
          <span class="text-ink-500 text-base sm:text-lg align-baseline ml-0.5">{cgpaScale}</span>
        </p>
      </div>
      {scholarship && (
        <div class="text-right shrink-0">
          <p class="meta text-ink-500 mb-1">Award</p>
          <p class="font-display text-sm font-semibold text-accent-600 leading-tight">
            {scholarship}
          </p>
        </div>
      )}
    </div>
  </article>
</section>
