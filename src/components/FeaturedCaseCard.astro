---
import CategoryPill from './CategoryPill.astro';

export interface Metric {
  label: string;
  value: string;
}

export interface Partner {
  name: string;
  url: string;
}

export interface Props {
  index: number;
  total: number;
  title: string;
  slug: string;
  year: number;
  category: string;
  summary: string;
  metric: Metric;
  thumbnail: string;
  partner?: Partner;
}

const {
  index,
  total,
  title,
  slug,
  year,
  category,
  summary,
  metric,
  thumbnail,
  partner,
} = Astro.props;

const idx = String(index).padStart(2, '0');
const totalPadded = String(total).padStart(2, '0');
---

<a href={`/projects/${slug}/`} class="block group focus:outline-none">
  <article class="card overflow-hidden h-full flex flex-col">
    <div class="aspect-[16/10] bg-cream-200 overflow-hidden">
      <img
        src={thumbnail}
        alt={`${title} cover illustration`}
        class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.02]"
        loading="lazy"
        decoding="async"
      />
    </div>
    <div class="p-6 flex flex-col flex-1">
      <header class="flex items-center justify-between gap-3 mb-4">
        <span class="num text-sm text-accent-600">{idx} / {totalPadded}</span>
        <CategoryPill label={category} />
      </header>
      <h3 class="font-display font-extrabold text-2xl lg:text-3xl tracking-tight leading-[1.05] text-ink-900 text-balance mb-3">
        {title}
      </h3>
      <p class="text-ink-700 text-pretty mb-5 flex-1">{summary}</p>
      <footer class="flex items-end justify-between gap-4 border-t border-line pt-4">
        <div class="min-w-0">
          <p class="meta text-ink-500 mb-1">{metric.label}</p>
          <p class="num text-2xl text-ink-900 truncate">{metric.value}</p>
        </div>
        <div class="text-right shrink-0 flex flex-col items-end gap-0.5">
          <span class="meta text-ink-500">{year}</span>
          {partner && (
            <a
              href={partner.url}
              target="_blank"
              rel="noreferrer noopener"
              class="group text-[0.78rem] font-mono text-accent-600 hover:text-accent-500 transition-colors inline-flex items-center gap-1 mt-0.5"
              aria-label={`Partner: ${partner.name}`}
            >
              <span class="border-b border-accent-300/60 group-hover:border-accent-500 transition-colors">{partner.name}</span>
              <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" aria-hidden="true" class="opacity-70 group-hover:opacity-100 group-hover:translate-x-[1px] transition-all">
                <path d="M7 17L17 7M17 7H8M17 7v9"/>
              </svg>
            </a>
          )}
        </div>
      </footer>
    </div>
  </article>
</a>
