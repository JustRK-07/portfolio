---
export interface Props {
  metrics: Array<{ value: string; label: string }>;
}
const { metrics } = Astro.props;
---

<dl class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-px bg-line rounded-sm overflow-hidden border border-line">
  {metrics.map((m) => (
    <div class="bg-navy-900 px-4 sm:px-5 py-5 sm:py-6">
      <dt class="meta mb-2 text-slate-500">{m.label}</dt>
      <dd class="num text-xl sm:text-2xl lg:text-3xl text-ink text-balance break-words">{m.value}</dd>
    </div>
  ))}
</dl>
