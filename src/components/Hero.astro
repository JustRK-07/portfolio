---
import TypewriterHero from './TypewriterHero.astro';
import MetricStrip from './MetricStrip.astro';

export interface Props {
  name: string;
  eyebrow: string;
  pitch: string;
  typewriterLines: string[];
  metrics: Array<{ value: string; label: string }>;
}

const { name, eyebrow, pitch, typewriterLines, metrics } = Astro.props;
---

<section id="about" class="scroll-mt-24">
  <p class="meta mb-4">{eyebrow}</p>

  <h2 class="font-display text-[clamp(2.25rem,8vw,6.5rem)] font-semibold leading-[0.95] tracking-tight text-balance break-words">
    {name}
  </h2>

  <p class="mt-4 text-slate-300 text-sm sm:text-base lg:text-lg max-w-full">
    {pitch}
  </p>

  <div class="mt-6">
    <TypewriterHero lines={typewriterLines} />
  </div>

  <div class="mt-10">
    <MetricStrip metrics={metrics} />
  </div>
</section>
