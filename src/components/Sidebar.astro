---
export interface Props {
  name: string;
  role: string;
  email: string;
  phone: string;
  location: string;
  resumeHref: string;
  githubHref: string;
  linkedinHref: string;
  codeforcesHref: string;
}

const {
  name,
  role,
  email,
  phone,
  location,
  resumeHref,
  githubHref,
  linkedinHref,
  codeforcesHref,
} = Astro.props;

const navItems = [
  { label: '01', href: '#about', name: 'About' },
  { label: '02', href: '#experience', name: 'Experience' },
  { label: '03', href: '#projects', name: 'Projects' },
  { label: '04', href: '#patents', name: 'Patents' },
  { label: '05', href: '#achievements', name: 'Achievements' },
  { label: '06', href: '#contact', name: 'Contact' },
];
---

<aside
  class="sidebar hidden lg:flex lg:flex-col lg:fixed lg:inset-y-0 lg:left-0 lg:w-[280px] lg:overflow-y-auto"
  aria-label="Primary"
>
  <div class="flex flex-col h-full p-8 gap-8">
    <header>
      <p class="meta mb-2">// about</p>
      <h1 class="font-display text-2xl font-semibold tracking-tight text-balance">
        {name}
      </h1>
      <p class="text-sm text-slate-300 mt-1 text-pretty">{role}</p>
    </header>

    <nav aria-label="Sections">
      <ul class="space-y-2">
        {navItems.map((item) => (
          <li>
            <a
              href={item.href}
              class="group flex items-baseline gap-3 text-slate-500 hover:text-teal-400 transition-colors"
              data-nav-link
            >
              <span class="num text-xs">{item.label}</span>
              <span class="text-sm">{item.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </nav>

    <div class="mt-auto space-y-4">
      <div class="flex items-center gap-3 text-slate-500">
        <a
          href={githubHref}
          target="_blank"
          rel="noreferrer noopener"
          aria-label="GitHub"
          class="hover:text-teal-400 transition-colors"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.13-3.2.69-3.87-1.36-3.87-1.36-.52-1.32-1.28-1.67-1.28-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.95 10.95 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.25 5.69.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.13 0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
          </svg>
        </a>
        <a
          href={linkedinHref}
          target="_blank"
          rel="noreferrer noopener"
          aria-label="LinkedIn"
          class="hover:text-teal-400 transition-colors"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8.4h4.55V24H.22V8.4zM8.34 8.4h4.36v2.13h.06c.61-1.15 2.1-2.37 4.32-2.37 4.62 0 5.48 3.04 5.48 7v8.84h-4.55v-7.84c0-1.87-.03-4.28-2.61-4.28-2.61 0-3.01 2.04-3.01 4.15V24H8.34V8.4z"/>
          </svg>
        </a>
        <a
          href={codeforcesHref}
          target="_blank"
          rel="noreferrer noopener"
          aria-label="Codeforces"
          class="hover:text-teal-400 transition-colors"
        >
          <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M4.5 7.5a3 3 0 1 1 0 6 3 3 0 0 1 0-6zm15 0a3 3 0 1 1 0 6 3 3 0 0 1 0-6zM2 7.2C2 5.43 3.43 4 5.2 4H9v2H5.2C4.54 6 4 6.54 4 7.2v6.6c0 .66.54 1.2 1.2 1.2H9v2H5.2C3.43 17 2 15.57 2 13.8V7.2zm20 0c0-1.77-1.43-3.2-3.2-3.2H15v2h3.8c.66 0 1.2.54 1.2 1.2v6.6c0 .66-.54 1.2-1.2 1.2H15v2h3.8c1.77 0 3.2-1.43 3.2-3.2V7.2zM8 11h8v2H8v-2z"/>
          </svg>
        </a>
      </div>

      <a
        href={resumeHref}
        download
        class="inline-flex items-center gap-2 text-sm text-teal-400 hover:text-teal-DEFAULT transition-colors"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"/>
        </svg>
        <span class="num">resume.pdf</span>
      </a>

      <div class="rule"></div>

      <div class="space-y-1 num text-xs">
        <a href={`mailto:${email}`} class="block text-slate-300 hover:text-teal-400 transition-colors">
          {email}
        </a>
        <span class="block text-slate-500">{phone}</span>
        <span class="block text-slate-500">{location}</span>
      </div>
    </div>
  </div>
</aside>

<!-- Mobile / tablet top bar -->
<header class="lg:hidden sticky top-0 z-30 bg-navy-900 border-b border-line">
  <div class="px-5 sm:px-8 py-4 flex items-center justify-between gap-4">
    <div>
      <h1 class="font-display text-base font-semibold">{name}</h1>
      <p class="text-xs text-slate-500">{role}</p>
    </div>
    <div class="flex items-center gap-3 text-slate-500">
      <a href={githubHref} target="_blank" rel="noreferrer noopener" aria-label="GitHub" class="hover:text-teal-400">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.13-3.2.69-3.87-1.36-3.87-1.36-.52-1.32-1.28-1.67-1.28-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.95 10.95 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.25 5.69.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.13 0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
        </svg>
      </a>
      <a href={linkedinHref} target="_blank" rel="noreferrer noopener" aria-label="LinkedIn" class="hover:text-teal-400">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M4.98 3.5C4.98 4.88 3.87 6 2.5 6S0 4.88 0 3.5 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM.22 8.4h4.55V24H.22V8.4zM8.34 8.4h4.36v2.13h.06c.61-1.15 2.1-2.37 4.32-2.37 4.62 0 5.48 3.04 5.48 7v8.84h-4.55v-7.84c0-1.87-.03-4.28-2.61-4.28-2.61 0-3.01 2.04-3.01 4.15V24H8.34V8.4z"/>
        </svg>
      </a>
      <a href={resumeHref} download class="text-xs num text-teal-400 hover:text-teal-DEFAULT">
        ↓ resume
      </a>
    </div>
  </div>
  <nav class="border-t border-line overflow-x-auto" aria-label="Sections">
    <ul class="flex px-5 sm:px-8 py-2 gap-5 min-w-max">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class="num text-xs text-slate-500 hover:text-teal-400 transition-colors whitespace-nowrap"
          >
            {item.label} {item.name}
          </a>
        </li>
      ))}
    </ul>
  </nav>
</header>
