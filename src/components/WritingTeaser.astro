---
export interface Post {
  title: string;
  description: string;
  date: string;
  readingTime?: string;
  href?: string;
}

export interface Props {
  posts: Post[];
  title?: string;
}

const { posts, title = '// journal' } = Astro.props;
---

<section class="space-y-5" aria-labelledby="writing-heading">
  <header class="flex items-center gap-3">
    <span aria-hidden="true" class="marker"></span>
    <h2 id="writing-heading" class="meta">{title}</h2>
  </header>
  <ul class="space-y-4">
    {posts.map((p) => (
      <li class="card p-5">
        <p class="meta text-ink-500 mb-1">
          {p.date}
          {p.readingTime && <span> · {p.readingTime}</span>}
        </p>
        <h3 class="font-display font-semibold text-base text-ink-900 text-balance">
          {p.href
            ? <a href={p.href} class="hover:text-accent-600 transition-colors">{p.title}</a>
            : p.title}
        </h3>
        <p class="text-sm text-ink-700 text-pretty mt-2 leading-relaxed">{p.description}</p>
      </li>
    ))}
  </ul>
</section>
