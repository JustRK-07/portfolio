---
import Base from '../layouts/Base.astro';
---

<Base
  title="404 — page not found · Rushabh Kalme"
  description="The page you're looking for couldn't be found. Use the back link to return to the portfolio."
  image="/og-image.svg"
>
  <main id="main-content" class="min-w-0">
    <article class="px-5 sm:px-8 lg:px-16 pt-20 sm:pt-28 pb-24 max-w-content mx-auto flex items-center justify-center min-h-[70vh]">
      <div class="card p-8 sm:p-12 max-w-prose text-center">
        <div class="flex items-center justify-center gap-3 mb-6">
          <span aria-hidden="true" class="marker"></span>
          <p class="meta">// not found</p>
        </div>

        <h1 class="font-display font-extrabold text-[clamp(5rem,18vw,10rem)] leading-[0.85] text-ink-900 tracking-tight mb-4">
          404
        </h1>

        <p class="font-serif italic text-2xl sm:text-3xl text-ink-700 leading-snug mb-2 text-balance">
          That URL is a dead track.
        </p>

        <p class="text-ink-500 text-base sm:text-lg max-w-prose-thin mx-auto text-pretty mb-8">
          The page you're looking for has moved, been renamed, or never existed. Use the back link to return to the home page.
        </p>

        <div class="flex flex-wrap items-center justify-center gap-4 pt-6 border-t border-line">
          <a
            href="/"
            class="inline-flex items-center gap-2 text-accent-600 hover:text-accent-500 transition-colors font-medium"
          >
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M19 12H5M12 19l-7-7 7-7"/>
            </svg>
            back to home
          </a>
          <span class="text-ink-300" aria-hidden="true">·</span>
          <a
            href="/#projects"
            class="inline-flex items-center gap-2 text-ink-500 hover:text-accent-600 transition-colors"
          >
            browse projects
          </a>
          <span class="text-ink-300" aria-hidden="true">·</span>
          <a
            href="/resume"
            class="inline-flex items-center gap-2 text-ink-500 hover:text-accent-600 transition-colors"
          >
            ↓ resume.pdf
          </a>
        </div>

        <p class="meta text-ink-300 mt-8">
          error 404 · track not allocated
        </p>
      </div>
    </article>
  </main>
</Base>
