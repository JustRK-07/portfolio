---
import Base from '../layouts/Base.astro';

const lastUpdated = '2026-09';
const fileSize = '108 KB';
const pages = 1;
---

<Base
  title="Resume — Rushabh Kalme"
  description="Resume of Rushabh Kalme — backend & distributed-systems engineer; Genxa Solutions internships, ISGEC industry engagement, multi-agent systems, WebRTC."
  image="/og-image.svg"
>
  <main id="main-content" class="min-w-0">
    <article class="px-5 sm:px-8 lg:px-16 pt-12 sm:pt-16 lg:pt-20 pb-24 max-w-content mx-auto">
      <a
        href="/#about"
        class="meta inline-flex items-center gap-2 mb-8 text-ink-500 hover:text-accent-600 transition-colors"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        back to home
      </a>

      <header class="mb-10 border-b border-line pb-8">
        <div class="flex items-center gap-3 mb-4">
          <span aria-hidden="true" class="marker"></span>
          <p class="meta">// resume</p>
        </div>

        <h1 class="font-display text-[clamp(2rem,5vw,3.5rem)] font-semibold leading-[1.05] tracking-tight text-balance mb-4 text-ink-900">
          Resume
        </h1>

        <p class="text-ink-700 text-base sm:text-lg max-w-prose-thin text-pretty mb-6">
          One-page PDF summary of the same work on <a href="/#about" class="text-accent-600 hover:text-accent-500 transition-colors underline decoration-accent-300/60 underline-offset-3">the home page</a>. Use the download link if you need a copy; the inline view loads the same file.
        </p>

        <div class="flex flex-wrap items-center gap-3">
          <a
            href="/resume.pdf"
            download
            class="inline-flex items-center gap-2 px-4 py-2 bg-accent-500 hover:bg-accent-600 text-cream-50 rounded-sm transition-colors font-medium"
          >
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
              <path d="M12 3v14M5 12l7 7 7-7M5 21h14"/>
            </svg>
            <span class="num">↓ download resume.pdf</span>
          </a>
          <span class="meta text-ink-500">last updated {lastUpdated}</span>
          <span class="text-ink-300" aria-hidden="true">·</span>
          <span class="meta text-ink-500">{fileSize} · {pages} page</span>
        </div>
      </header>

      <section class="mb-12">
        <div class="bg-cream-200 border border-line rounded overflow-hidden">
          <object
            data="/resume.pdf"
            type="application/pdf"
            class="w-full"
            style="aspect-ratio: 8.5 / 11; min-height: 1100px;"
            aria-label="Resume of Rushabh Kalme"
          >
            <div class="p-12 text-center">
              <p class="text-ink-700 mb-4">
                Your browser doesn't support inline PDF viewing.
              </p>
              <a
                href="/resume.pdf"
                download
                class="inline-flex items-center gap-2 px-4 py-2 bg-accent-500 hover:bg-accent-600 text-cream-50 rounded-sm transition-colors font-medium"
              >
                ↓ download resume.pdf
              </a>
            </div>
          </object>
        </div>
      </section>

      <section class="card p-6 mb-8">
        <h2 class="meta mb-4">// what's in this resume</h2>
        <ul class="space-y-3 text-ink-700 text-pretty leading-relaxed">
          <li class="flex items-baseline gap-3">
            <span class="text-accent-500 num text-sm mt-1" aria-hidden="true">→</span>
            <span><b class="text-ink-900">Title:</b> Software Engineer · Backend &amp; Distributed Systems · Cummins Inc. Merit Scholar '25</span>
          </li>
          <li class="flex items-baseline gap-3">
            <span class="text-accent-500 num text-sm mt-1" aria-hidden="true">→</span>
            <span><b class="text-ink-900">Education:</b> B.Tech CS (IoT &amp; Cybersecurity), VIT Pune · 9.29 / 10 · 2024–28</span>
          </li>
          <li class="flex items-baseline gap-3">
            <span class="text-accent-500 num text-sm mt-1" aria-hidden="true">→</span>
            <span><b class="text-ink-900">Experience:</b> Two internships at <b class="text-ink-900">Genxa Solutions</b> (Pune) — WebRTC SDK &amp; voice agent platform</span>
          </li>
          <li class="flex items-baseline gap-3">
            <span class="text-accent-500 num text-sm mt-1" aria-hidden="true">→</span>
            <span><b class="text-ink-900">Industry:</b> Two industry projects — ISGEC Heavy Engineering (CAD validation) &amp; Yantrikisoft (demand forecasting)</span>
          </li>
          <li class="flex items-baseline gap-3">
            <span class="text-accent-500 num text-sm mt-1" aria-hidden="true">→</span>
            <span><b class="text-ink-900">IP:</b> 4 patents filed + 1 IEEE paper accepted (I2ITCON 2026)</span>
          </li>
          <li class="flex items-baseline gap-3">
            <span class="text-accent-500 num text-sm mt-1" aria-hidden="true">→</span>
            <span><b class="text-ink-900">Recognitions:</b> Codeforces Expert (1619, top 10%), 1st Place AIXPLORE 2K26, CODE APEX 2.0 winner</span>
          </li>
        </ul>
      </section>

      <footer class="border-t border-line pt-8">
        <p class="meta text-ink-500">
          PDF regenerates each time <code class="text-ink-700">public/resume.pdf</code> is replaced. Build &amp; deploy with <code class="text-ink-700">npm run build</code>.
        </p>
      </footer>
    </article>
  </main>
</Base>
