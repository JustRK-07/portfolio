---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import CategoryPill from '../../components/CategoryPill.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects
    .filter((p) => p.data.caseStudy !== false && p.data.caseStudy !== undefined)
    .map((p) => ({
      params: { slug: p.slug },
      props: { project: p },
    }));
}

const { project } = Astro.props;
const data = project.data;
const slug = project.slug;
const gallery = data.images && data.images.length > 0 ? data.images : [data.thumbnail];
const { Content } = await project.render();

// Image alt map (mirrors ProjectCard.astro).
const alts: Record<string, string> = {
  'adv-cad-validation': 'CAD drawing of test1 (Sheet 0001) with multiple hard-clash markers highlighted across structural members',
  'intellicredit': 'Credit appraisal memo for Tata Steel with a 7-agent LangGraph workflow',
  'foretell-vista': '7-day demand forecast chart for SKU-5821 with a promo flag and confidence band',
};
const coverAlt = alts[slug] ?? `${data.title} cover image`;
---

<Base
  title={`${data.title} — Case study · Rushabh Kalme`}
  description={data.summary}
  image={gallery[0]}
>
  <main id="main-content" class="min-w-0">
    <article class="px-5 sm:px-8 lg:px-16 pt-12 sm:pt-16 lg:pt-20 pb-24 max-w-content mx-auto">
      <!-- Back link -->
      <a
        href="/#projects"
        class="meta inline-flex items-center gap-2 mb-8 text-slate-500 hover:text-teal-400 transition-colors"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path d="M19 12H5M12 19l-7-7 7-7"/>
        </svg>
        back to projects
      </a>

      <!-- Header -->
      <header class="mb-12 border-b border-line pb-10">
        <div class="flex flex-wrap items-center gap-3 mb-4">
          <span class="num meta text-slate-500">{data.year}</span>
          <CategoryPill label={data.category} />
          {data.role && (
            <span class="meta text-slate-400">· {data.role}</span>
          )}
        </div>

        <h1 class="font-display text-[clamp(2rem,5vw,3.5rem)] font-semibold leading-[1.05] tracking-tight text-balance break-words mb-5">
          {data.title}
        </h1>

        <p class="text-slate-300 text-base sm:text-lg max-w-prose-thin text-pretty">
          {data.summary}
        </p>

        <div class="mt-6 flex flex-wrap items-center gap-3">
          {data.githubUrl && (
            <a
              href={data.githubUrl}
              target="_blank"
              rel="noreferrer noopener"
              class="inline-flex items-center gap-2 text-sm text-teal-400 hover:text-teal-DEFAULT transition-colors"
            >
              <svg width="14" height="14" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                <path d="M12 .5C5.65.5.5 5.65.5 12c0 5.08 3.29 9.39 7.86 10.91.58.11.79-.25.79-.56 0-.27-.01-1.17-.02-2.13-3.2.69-3.87-1.36-3.87-1.36-.52-1.32-1.28-1.67-1.28-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.76 1.18 1.76 1.18 1.03 1.76 2.7 1.25 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.7 0-1.26.45-2.29 1.18-3.1-.12-.29-.51-1.46.11-3.04 0 0 .96-.31 3.15 1.18a10.95 10.95 0 0 1 5.74 0c2.19-1.49 3.15-1.18 3.15-1.18.62 1.58.23 2.75.11 3.04.74.81 1.18 1.84 1.18 3.1 0 4.43-2.69 5.41-5.25 5.69.41.35.78 1.05.78 2.12 0 1.53-.01 2.76-.01 3.13 0 .31.21.68.8.56C20.21 21.39 23.5 17.08 23.5 12 23.5 5.65 18.35.5 12 .5z"/>
              </svg>
              <span class="num">source on GitHub</span>
            </a>
          )}
          {data.demoUrl && (
            <a
              href={data.demoUrl}
              target="_blank"
              rel="noreferrer noopener"
              class="inline-flex items-center gap-2 text-sm text-teal-400 hover:text-teal-DEFAULT transition-colors"
            >
              <span class="num">live demo ↗</span>
            </a>
          )}
        </div>
      </header>

      <!-- Cover image -->
      <img
        src={gallery[0]}
        alt={coverAlt}
        class="w-full rounded border border-line bg-navy-900 mb-12"
      />

      {data.metrics && data.metrics.length > 0 && (
        <section class="mb-16">
          <h2 class="meta mb-4">// outcome</h2>
          <dl class="grid grid-cols-2 sm:grid-cols-4 gap-3">
            {data.metrics.map((m) => (
              <div class="border border-line rounded-sm py-3 px-4 text-center bg-navy-900">
                <dt class="meta !text-[0.6rem] !tracking-[0.15em] mb-1.5">{m.label}</dt>
                <dd class="num text-xl text-ink font-mono">{m.value}</dd>
              </div>
            ))}
          </dl>
        </section>
      )}

      <!-- Problem / Approach columns -->
      <section class="grid md:grid-cols-2 gap-8 mb-16">
        <div class="card p-6">
          <h2 class="meta mb-3">// problem</h2>
          <p class="text-slate-300 text-pretty leading-relaxed">{data.problem}</p>
        </div>
        <div class="card p-6">
          <h2 class="meta mb-3">// approach</h2>
          <p class="text-slate-300 text-pretty leading-relaxed">{data.approach}</p>
        </div>
      </section>

      <!-- Results -->
      <section class="mb-16">
        <h2 class="meta mb-4">// results</h2>
        <ul class="space-y-3">
          {data.results.map((r) => (
            <li class="flex items-baseline gap-3 text-slate-200 leading-relaxed">
              <span class="text-teal-400 num text-sm mt-1">→</span>
              <span class="text-pretty">{r}</span>
            </li>
          ))}
        </ul>
      </section>

      <!-- Image gallery -->
      {gallery.length > 0 && (
        <section class="mb-16">
          <h2 class="meta mb-4">// screens</h2>
          <div class="space-y-6">
            {gallery.slice(0, 6).map((src, i) => (
              <figure class="border border-line rounded bg-navy-900 overflow-hidden">
                <img
                  src={src}
                  alt={`${data.title} — screen ${i + 1}`}
                  class="w-full"
                  loading="lazy"
                />
              </figure>
            ))}
          </div>
        </section>
      )}

      <!-- Body from MDX -->
      <section class="mb-16 max-w-prose">
        <h2 class="meta mb-4">// in depth</h2>
        <div class="prose-case text-slate-300 leading-relaxed space-y-4">
          <Content />
        </div>
      </section>

      <!-- Tech stack -->
      <section class="mb-16">
        <h2 class="meta mb-4">// stack</h2>
        <div class="flex flex-wrap gap-1.5">
          {data.tech.map((t) => <span class="pill">{t}</span>)}
        </div>
      </section>

      <!-- Footer of article -->
      <footer class="border-t border-line pt-8 mt-16">
        <a
          href="/#projects"
          class="inline-flex items-center gap-2 text-teal-400 hover:text-teal-DEFAULT transition-colors"
        >
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
            <path d="M19 12H5M12 19l-7-7 7-7"/>
          </svg>
          <span>back to all projects</span>
        </a>
      </footer>
    </article>
  </main>
</Base>

<style>
  /* Tight styles for the rendered MDX content */
  .prose-case :global(h2) {
    color: var(--text-primary);
    font-weight: 600;
    margin-top: 1.5em;
    margin-bottom: 0.5em;
    font-size: 1.15rem;
  }
  .prose-case :global(p) {
    color: var(--slate-300);
    line-height: 1.7;
  }
  .prose-case :global(a) {
    color: var(--teal-400);
    text-decoration: underline;
    text-decoration-color: rgba(94, 234, 212, 0.4);
    text-underline-offset: 3px;
  }
  .prose-case :global(a:hover) {
    color: var(--teal-500);
  }
  .prose-case :global(strong) {
    color: var(--text-primary);
  }
  .prose-case :global(code) {
    font-family: 'JetBrains Mono Variable', ui-monospace, monospace;
    background: rgba(94, 234, 212, 0.08);
    padding: 1px 6px;
    border-radius: 3px;
    font-size: 0.92em;
  }
  .prose-case :global(ul),
  .prose-case :global(ol) {
    padding-left: 1.5em;
    color: var(--slate-300);
  }
  .prose-case :global(li) {
    margin: 0.4em 0;
  }
</style>
